{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Jekyll",
      "type": "shell",
      "command": "bundle exec jekyll serve --baseurl='' --host localhost --port 4000",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "options": {
        "cwd" : "${workspaceFolder}/docs"
      },
      "problemMatcher":[
        {
          "base": "$tsc",
          "background": {
            "activeOnStart": true,
            "beginsPattern":"Configuration file:",
            "endsPattern":"Server running..."
          },
        }
      ]
    }
  ]
}
